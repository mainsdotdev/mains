{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node"
    ],
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "allowJs": true,
    "checkJs": true
  },
  "include": [
    "test/**/*.ts",
    "test/**/*.mjs",
    "scripts/**/*.ts",
    "scripts/**/*.mjs",
    "vitest.config.ts"
  ]
}
