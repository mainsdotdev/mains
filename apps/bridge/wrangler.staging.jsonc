{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mains-bridge-staging",
  "account_id": "68e5ea9f7e1e6a56120e6c366eda1a59",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": false },
    "traces": { "enabled": false },
    "issues": { "enabled": false }
  },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "secrets": { "required": ["BETTER_AUTH_SECRET", "GITHUB_CLIENT_SECRET", "RESEND_API_KEY"] },
  "vars": {
    "BRIDGE_ENV": "staging",
    "BRIDGE_DEV_AUTH": "false",
    "BRIDGE_AUTH_URL": "https://mains-bridge-staging.team-68e.workers.dev",
    "GITHUB_CLIENT_ID": "Ov23livSdwQ720Sax55l",
    "MAIL_FROM": "Mains Staging <no-reply-staging@auth.mains.dev>",
    "BRIDGE_MAIL_DAILY_LIMIT": "10"
  },
  "d1_databases": [{
    "binding": "AUTH_DB",
    "database_name": "mains-bridge-staging-auth",
    "database_id": "c2c1b89b-566e-49da-8aab-0a0bda098a81",
    "migrations_dir": "migrations"
  }],
  "r2_buckets": [
    { "binding": "BLOBS", "bucket_name": "mains-bridge-staging-blobs" },
    { "binding": "BLOB_ARCHIVE", "bucket_name": "mains-bridge-staging-archive" }
  ],
  "durable_objects": {
    "bindings": [{ "name": "ACCOUNT_HUB", "class_name": "AccountHub" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AccountHub"] }]
}
