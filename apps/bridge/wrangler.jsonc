{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mains-bridge-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [{ "binding": "AUTH_DB", "database_name": "mains-bridge-auth", "database_id": "replace-with-d1-database-id", "migrations_dir": "migrations" }],
  "workers_dev": false,
  "vars": { "BRIDGE_ENV": "local" },
  "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "mains-bridge-blobs" }],
  "durable_objects": {
    "bindings": [{ "name": "ACCOUNT_HUB", "class_name": "AccountHub" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AccountHub"] }],
  "dev": { "ip": "127.0.0.1", "port": 8790 }
}
