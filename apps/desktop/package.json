{
  "name": "mains",
  "type": "commonjs",
  "productName": "Mains",
  "version": "0.9.0",
  "description": "AI-powered developer workspace",
  "main": ".vite/build/main.js",
  "publish": {
    "provider": "github",
    "owner": "mainsdotdev",
    "repo": "mains"
  },
  "scripts": {
    "test": "npm rebuild better-sqlite3 && vitest run",
    "test:watch": "npm rebuild better-sqlite3 && vitest",
    "test:coverage": "npm rebuild better-sqlite3 && vitest run --coverage",
    "start": "ulimit -n 65536 && electron-forge start",
    "serve": "ulimit -n 65536 && MAINS_SERVE=1 electron-forge start",
    "serve:tailscale": "ulimit -n 65536 && MAINS_SERVE=1 MAINS_TAILSCALE_SERVE=1 electron-forge start",
    "build:web": "vite build --config vite.renderer.config.mjs --outDir ../../dist-web --emptyOutDir --sourcemap",
    "benchmark": "npm run benchmark:renderer && npm run benchmark:transcript",
    "benchmark:renderer": "node --experimental-vm-modules scripts/benchmark-renderer-startup.mjs --assert",
    "benchmark:transcript": "vitest bench src/renderer/features/workspace/lib/transcript-performance.bench.ts --run",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:studio:runtime": "drizzle-kit studio --config drizzle.config.runtime.ts",
    "db:clean:dev": "rm -f .data/mains.db .data/mains.db-shm .data/mains.db-wal .data/mains.db.pre-migration-backup*",
    "db:clean:runtime": "rm -f ~/Library/Application\\ Support/mains/mains.db ~/Library/Application\\ Support/mains/mains.db-shm ~/Library/Application\\ Support/mains/mains.db-wal && echo 'Runtime database cleaned. Restart the app to recreate.'",
    "db:clean:all": "npm run db:clean:dev && npm run db:clean:runtime",
    "lint": "eslint src/ scripts/",
    "lint:fix": "eslint src/ scripts/ --fix",
    "typecheck": "tsc --noEmit -p tsconfig.main.json && tsc --noEmit -p tsconfig.preload.json && tsc --noEmit -p tsconfig.renderer.json",
    "reset": "npm rebuild better-sqlite3 && npm run db:clean:dev",
    "hard-reset": "npm run reset && rm -rf node_modules package-lock.json .vite dist .webpack && npm install",
    "clean": "rm -rf .vite dist out .webpack node_modules/.vite node_modules/.cache",
    "codex:protocol:generate": "node scripts/generate-codex-app-server-protocol.mjs",
    "codex:protocol:smoke": "node scripts/smoke-codex-app-server-protocol.mjs",
    "licenses:generate": "node scripts/generate-third-party-notices.mjs"
  },
  "keywords": [
    "electron",
    "ai",
    "developer-tools",
    "github-copilot",
    "claude",
    "workspace",
    "sqlite",
    "react",
    "desktop-app"
  ],
  "author": {
    "name": "Mains",
    "email": "team@mains.dev",
    "url": "https://github.com/mainsdotdev"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mainsdotdev/mains.git"
  },
  "homepage": "https://github.com/mainsdotdev/mains#readme",
  "bugs": {
    "url": "https://github.com/mainsdotdev/mains/issues"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "build": {
    "publish": {
      "provider": "github",
      "owner": "mainsdotdev",
      "repo": "mains"
    }
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron-forge/publisher-github": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@electron/rebuild": "^4.2.0",
    "@eslint/js": "^9.39.5",
    "@mains/contracts": "file:../../packages/contracts",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/better-sqlite3": "^9.6.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.5.5",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "electron": "^41.10.6",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.266",
    "@anthropic-ai/sdk": "^0.124.0",
    "@github/copilot-sdk": "^1.0.11",
    "@linear/sdk": "^94.0.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@number-flow/react": "^0.6.2",
    "@octokit/rest": "^22.0.1",
    "@pierre/diffs": "^1.4.1",
    "@reduxjs/toolkit": "^2.12.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "docx-preview": "^0.4.0",
    "drizzle-orm": "^0.45.2",
    "electron-squirrel-startup": "^1.0.1",
    "exceljs": "^4.4.0",
    "frimousse": "^0.3.0",
    "jszip": "^3.10.2",
    "katex": "^0.18.7",
    "motion": "^13.2.0",
    "nanoid": "^6.0.1",
    "node-pty": "^1.1.0",
    "pptx-preview": "^1.0.7",
    "qrcode-generator": "^2.0.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.3",
    "redux-persist": "^6.0.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "simple-git": "^3.36.0",
    "tailwind-merge": "^3.6.0",
    "update-electron-app": "^3.3.0",
    "ws": "^8.21.3",
    "zod": "^4.5.4"
  },
  "overrides": {
    "tar": "^7.5.22",
    "esbuild": "^0.28.2",
    "tmp": "^0.2.7",
    "@tootallnate/once": "^2.0.1",
    "@xmldom/xmldom": "^0.9.12",
    "@github/copilot": "1.0.79",
    "@typescript-eslint/typescript-estree": {
      "brace-expansion": "^5.0.9"
    },
    "express-rate-limit": "^8.6.2",
    "fast-uri": "^3.1.6",
    "hono": "^4.13.5",
    "ip-address": "^10.5.0",
    "js-yaml": "^4.3.2",
    "picomatch": "^4.0.5",
    "qs": "^6.16.0",
    "uuid": "^11.1.1",
    "pptx-preview": {
      "echarts": "^6.1.0"
    }
  }
}
