// TypeScript configuration for the Preload Process
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "lib": ["ES2020"],
    "jsx": "preserve",
    "outDir": ".vite/build",
    "types": ["node"]
  },
  "include": [
    "src/preload/**/*",
    "src/shared/**/*"
  ]
}
