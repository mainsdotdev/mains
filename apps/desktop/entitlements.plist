<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Electron/V8 JIT compilation -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <!-- Native modules: better-sqlite3, node-pty -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- Required for unsigned prebuilt binaries: @github/copilot-*, node-pty prebuilds -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- Allow AppleScript / Apple events to other apps (Music, Mail, System Events, …) under Hardened Runtime -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
</dict>
</plist>
