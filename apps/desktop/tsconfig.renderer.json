// TypeScript configuration for the Renderer Process
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "outDir": ".vite/renderer",
    "types": ["vite/client"],
    "paths": {
      "@/*": ["./src/renderer/*"]
    }
  },
  "include": [
    "src/renderer/**/*",
    "src/preload/types.d.ts",
    "src/shared/**/*"
  ]
}
