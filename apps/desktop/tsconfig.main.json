// TypeScript configuration for the Main Process
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "../..",
    "lib": ["ES2020"],
    "jsx": "preserve",
    "outDir": ".vite/build",
    "types": ["node"]
  },
  "include": [
    "src/main/**/*",
    "src/shared/**/*",
    "src/test/**/*",
    "../../packages/backend/src/**/*",
    "../../packages/backend/shared/**/*",
    "../../packages/backend/test/**/*"
  ]
}
