RELAY_DOMAIN=relay.mains.dev

# Defaults expose only Caddy on TCP 80/443. The Go listener stays private.
# RELAY_BIND_ADDRESS=0.0.0.0
# RELAY_HTTP_PORT=80
# RELAY_HTTPS_PORT=443

# Absolute path if you keep the operator key outside this checkout.
# RELAY_SECRET_FILE=/absolute/path/to/routing.secret
