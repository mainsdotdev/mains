# Copy to fastlane/.env (ignored). Use an App Store Connect Team API key with
# App Manager access for uploading builds and editing TestFlight release notes.
ASC_KEY_ID=
ASC_ISSUER_ID=
# Absolute path to the downloaded .p8, kept outside the repository.
ASC_KEY_PATH=

# Optional TestFlight "What to Test" text; defaults to the version/build label.
MAINS_BETA_CHANGELOG=
