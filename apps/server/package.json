{
  "name": "@mains/server",
  "version": "0.11.0",
  "description": "Standalone Mains backend and web UI",
  "type": "commonjs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mainsdotdev/mains.git"
  },
  "homepage": "https://github.com/mainsdotdev/mains#readme",
  "bugs": {
    "url": "https://github.com/mainsdotdev/mains/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "serve": "npm run build && npm run build:web && node .vite/server/server.cjs",
    "build": "vite build --config vite.config.mjs",
    "start": "node .vite/server/server.cjs",
    "build:web": "npm --prefix ../desktop run build:web",
    "package": "npm run build && npm run build:web && node scripts/package.mjs",
    "smoke:package": "node scripts/smoke-package.mjs",
    "test": "npm rebuild better-sqlite3 && vitest run",
    "test:watch": "npm rebuild better-sqlite3 && vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ scripts/"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.272",
    "@github/copilot-sdk": "1.0.11",
    "@linear/sdk": "94.0.0",
    "@octokit/rest": "22.0.1",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.2",
    "nanoid": "6.0.1",
    "node-pty": "1.1.0",
    "simple-git": "3.36.0",
    "ws": "8.21.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@mains/backend": "file:../../packages/backend",
    "@mains/contracts": "file:../../packages/contracts",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.0",
    "@types/ws": "^8.18.1",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "private": true
}
